{
  "name": "cypress-login-autotests",
  "description": "End-to-end tests for authentication and password recovery on login.qa.studio",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:login": "cypress run --spec \"cypress/e2e/auth/login.cy.js\"",
    "cy:run:recovery": "cypress run --spec \"cypress/e2e/auth/password-recovery.cy.js\"",
    "cy:run:known-bug": "cypress run --spec \"cypress/e2e/auth/login-known-bug.cy.js\""
  },
  "devDependencies": {
    "cypress": "^15.21.1"
  }
}
